# Copy to `.env` and fill in. Never commit `.env`.

# Firebase service account used by the API (Project settings → Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with `\n` for newlines, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=

# Set to use the local Firestore emulator instead (e.g. 127.0.0.1:8080).
# The service account variables above are then optional.
# FIRESTORE_EMULATOR_HOST=

# Firebase web app config for the browser (Project settings → General → Your apps).
# These are public by design: mark them "Config", not "Secret", in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to use the local Auth emulator instead (e.g. 127.0.0.1:9099).
# VITE_FIREBASE_AUTH_EMULATOR_HOST=
